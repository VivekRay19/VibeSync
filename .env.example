# ==============================================================================
# VibeSync Environment Configuration (Neon Serverless Stack)
# ==============================================================================

# ------------------------------------------------------------------------------
# Neon Database (Lakebase Postgres)
# ------------------------------------------------------------------------------
# Pooled connection string for serverless API handlers & runtime queries
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-odd-heart-b3lqslom-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Direct unpooled connection string for migrations and DDL
DATABASE_URL_UNPOOLED=postgresql://neondb_owner:YOUR_PASSWORD@ep-odd-heart-b3lqslom.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Active branch identifier
NEON_BRANCH=production

# ------------------------------------------------------------------------------
# Security & HMAC Session Secret
# ------------------------------------------------------------------------------
# High-entropy random secret key for HMAC-SHA256 session signing
NEON_SESSION_SECRET=your-random-32-character-secret-key-for-session-tokens

# ------------------------------------------------------------------------------
# Neon Auth (Managed Better Auth)
# ------------------------------------------------------------------------------
NEON_AUTH_BASE_URL=https://ep-odd-heart-b3lqslom.neonauth.c-4.ap-southeast-1.aws.neon.tech/neondb/auth
NEON_AUTH_COOKIE_SECRET=your-auth-cookie-secret-min-32-chars

# ------------------------------------------------------------------------------
# Neon Object Storage (S3-Compatible Bucket for Room Assets & Playlists)
# ------------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=your-neon-storage-access-key-id
AWS_SECRET_ACCESS_KEY=your-neon-storage-secret-access-key
AWS_REGION=ap-southeast-1
AWS_ENDPOINT_URL_S3=https://storage.c-4.ap-southeast-1.aws.neon.tech

# ------------------------------------------------------------------------------
# Music Provider Catalogs
# ------------------------------------------------------------------------------
# Audius API Key (Optional)
# Audius decentralized public nodes work out-of-the-box for free without a key.
# If you have a registered Audius developer API key, provide it here for higher rate limits.
AUDIUS_API_KEY=

# Jamendo API Client ID (Optional)
# Obtain a free developer client_id at https://developer.jamendo.com/
# If left blank, VibeSync uses Audius as primary music catalog.
JAMENDO_CLIENT_ID=

# ------------------------------------------------------------------------------
# Application URL
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
