# ==============================================================================
# VibeSync Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase Configuration
# ------------------------------------------------------------------------------
# Obtain from your Supabase project dashboard: Project Settings -> API
# NEXT_PUBLIC_SUPABASE_URL: Project URL (e.g., https://your-project-id.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY / NEXT_PUBLIC_SUPABASE_ANON_KEY: Public Anon Key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-public-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# SUPABASE_SECRET_KEY: Service Role Key (Keep secret! NEVER prefix with NEXT_PUBLIC_)
# Used for server-side trusted actions and migrations
SUPABASE_SECRET_KEY=your-supabase-service-role-secret-key

# ------------------------------------------------------------------------------
# Music Provider Catalogs
# ------------------------------------------------------------------------------
# Audius API Key (Optional)
# Audius public decentralized nodes work out-of-the-box for free without a key.
# If you have a registered Audius developer API key, provide it here for higher rate limits.
AUDIUS_API_KEY=

# Jamendo API Client ID (Optional)
# Obtain a free developer client_id at https://developer.jamendo.com/
# If left blank, VibeSync gracefully disables Jamendo and uses Audius as primary catalog.
JAMENDO_CLIENT_ID=

# ------------------------------------------------------------------------------
# Application URL
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
